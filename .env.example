# Copy this file to ".env" and fill in your values. Never commit ".env".

# --- Diagnostic LLM (provider decided in Phase 6: edit these lines to switch provider) ---
# Provider: openai | anthropic | gemini  ("openai" also works for OpenAI-compatible services via the base URL)
LOGAGENT_LLM_PROVIDER=
LOGAGENT_LLM_API_KEY=
LOGAGENT_LLM_MODEL=
# Only needed for OpenAI-compatible services:
# LOGAGENT_LLM_BASE_URL=https://api.openai.com/v1
# List prices in USD per 1 million tokens (copy them from the provider's pricing page; used for cost figures)
LOGAGENT_PRICE_IN_PER_MTOK=
LOGAGENT_PRICE_OUT_PER_MTOK=

# --- Local classifier (optional overrides) ---
# LOGAGENT_MODEL_DIR=models/merged
# LOGAGENT_DTYPE=float32
# LOGAGENT_THRESHOLD=0.5
# LOGAGENT_TORCH_THREADS=8

# --- Backend ---
LOGAGENT_CORS_ORIGINS=http://localhost:5173